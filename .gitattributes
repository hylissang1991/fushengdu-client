# =====================================================================
# 《浮生渡》客户端 · .gitattributes
# 作用：① 文本资源统一换行符（消除 meta 的 CRLF 提示）；② 标记二进制资源；
#       ③ 预留 LFS 规则（启用前须先安装 git-lfs 并运行 git lfs install）。

# ---- 换行符：仓库内统一存 LF，工作区按平台还原（Unity 跨平台一致）----
* text=auto eol=lf
# ---- Unity 文本资源（强制按文本处理，便于 diff/merge）----
*.cs        text
*.meta      text
*.unity     text
*.prefab    text
*.asset     text
*.mat       text
*.physicMaterial        text
*.physicsMaterial2D     text
*.controller text
*.anim      text
*.overrideController text
*.shader    text eol=lf
*.compute   text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.glslinc   text eol=lf
*.json      text
*.txt       text
*.xml       text
*.csv       text
*.tsv       text
*.md        text
*.gitattributes text
*.gitignore text
# ---- 二进制资源（不文本化；LFS 见下方预留段）----
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.exr  binary
*.tiff binary
*.bmp  binary
*.gif  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.aiff binary
*.aif  binary
*.unitypackage binary
*.assetbundle binary
*.bundle binary
*.zip  binary
*.7z   binary
*.dll  binary
*.so   binary
*.dylib binary
# LFS 规则（预留）—— 启用步骤：
#   1) 安装 git-lfs：https://git-lfs.com  （或包管理器）
#   2) git lfs install
#   3) 取消下面 12 行注释（即启用 filter=lfs）
#   4) 把【已入库】的 Assets/Art 等巨型二进制迁出普通 git、迁入 LFS：
#      git lfs migrate import --include="*.png,*.jpg,*.jpeg,*.tga,*.psd,*.exr,*.tiff,*.bmp,*.fbx,*.wav,*.mp3,*.ogg" --everything
#      （此命令会重写初始提交，本仓库尚无远程，安全；若有协作者需重新 clone）
#   5) 之后新的同类二进制在 git add 时自动走 LFS。
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.bmp  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
