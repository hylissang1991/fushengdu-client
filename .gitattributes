# =====================================================================
# 《浮生渡》客户端 · .gitattributes
# 作用：① 文本资源统一换行符（消除 meta 的 CRLF 提示）；② 标记二进制资源；
#       ③ LFS 规则（git-lfs 3.8.1 已装并 git lfs install，见文件末尾）。

# ---- 换行符：仓库内统一存 LF，工作区按平台还原（Unity 跨平台一致）----
* text=auto eol=lf
# ---- Unity 文本资源（强制按文本处理，便于 diff/merge）----
*.cs        text
*.meta      text
*.unity     text
*.prefab    text
*.asset     text
*.mat       text
*.physicMaterial        text
*.physicsMaterial2D     text
*.controller text
*.anim      text
*.overrideController text
*.shader    text eol=lf
*.compute   text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.glslinc   text eol=lf
*.json      text
*.txt       text
*.xml       text
*.csv       text
*.tsv       text
*.md        text
*.gitattributes text
*.gitignore text
# ---- 二进制资源（不文本化；LFS 见下方预留段）----
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.exr  binary
*.tiff binary
*.bmp  binary
*.gif  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.aiff binary
*.aif  binary
*.unitypackage binary
*.assetbundle binary
*.bundle binary
*.zip  binary
*.7z   binary
*.dll  binary
*.so   binary
*.dylib binary
# ---- LFS 规则（已启用：git-lfs 3.8.1 已装、git lfs install 已跑）----
# 这些类型在 git add 时自动走 LFS，不再进普通 git blob。
#
# 注意：本段只对【新提交】生效。已入库的历史文件仍躺在普通 git 里，
#       需要 git lfs migrate import --include="..." --everything 才会迁出
#       （会重写历史；本仓库目前仅 4 个提交、无协作者，真要跑代价可控）。
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.bmp  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.obj  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
# 烘焙出的角色网格（YAML Mesh，13~14 MB/个）。
# **按路径精确命中**，不用全局 *.asset —— 全仓 12 个 .asset 里有 6 个是
# 几 KB 的 ScriptableObject，把它们丢进 LFS 只会白白多一轮指针往返。
Assets/Resources/Art/**/*.asset filter=lfs diff=lfs merge=lfs -text
